{
  "name": "tabulark",
  "version": "0.1.0",
  "description": "A WebAssembly-first engine for format-agnostic tabular data preview",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:js && npm run build:wasm",
    "build:js": "node scripts/build.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "check": "npm run check:versions && npm run typecheck && npm test && npm run package:check && npm run pages:check",
    "check:versions": "node scripts/check-versions.mjs",
    "example": "npm run build:pages && node test/browser/server.mjs",
    "pages:check": "npm run build:pages",
    "package:check": "npm pack --dry-run --cache target/npm-cache",
    "test": "npm run build:js && node --test test/*.test.js",
    "test:browser": "npm run build:pages && playwright test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ronbb/tabulark.git"
  },
  "bugs": {
    "url": "https://github.com/Ronbb/tabulark/issues"
  },
  "homepage": "https://ronbb.github.io/tabulark/",
  "keywords": [
    "table",
    "tabular",
    "preview",
    "webassembly",
    "canvas"
  ],
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
