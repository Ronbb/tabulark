{
  "name": "@tabulark/document-preview",
  "version": "0.1.0-experimental.0",
  "description": "Experimental local-only paged document preview for Tabulark",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "test:browser": "npm run build && node ../../node_modules/@playwright/test/cli.js test --config playwright.config.mjs",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@hyzyla/pdfium": "2.1.13"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
