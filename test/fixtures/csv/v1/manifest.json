{
  "version": 1,
  "chunkSizes": [1, 2, 3, 5, 16, 4096],
  "cases": [
    {
      "id": "rfc-quotes-crlf-bom",
      "file": "rfc-quotes.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "strict"
      },
      "source": {
        "lineEndings": "crlf",
        "utf8Bom": true
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 3,
          "columns": ["name", "note"],
          "schemaVersion": 1
        },
        "rows": [
          ["Alice", "hello\r\nworld"],
          ["Bob", "a \"quote\""],
          ["Zoë", "上海,浦东"]
        ],
        "warnings": []
      }
    },
    {
      "id": "tsv-empty-fields",
      "file": "empty-fields.tsv",
      "options": {
        "format": "tsv",
        "header": true,
        "mode": "strict"
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 3,
          "columns": ["id", "value", "note"],
          "schemaVersion": 1
        },
        "rows": [
          ["1", "", "alpha"],
          ["2", "beta", ""],
          ["3", "", ""]
        ],
        "warnings": []
      }
    },
    {
      "id": "tsv-cjk-crlf-bom",
      "file": "cjk-mixed.tsv",
      "options": {
        "format": "tsv",
        "header": true,
        "mode": "strict"
      },
      "source": {
        "lineEndings": "crlf",
        "utf8Bom": true
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 2,
          "columns": ["中文标题", "日本語ヘッダー", "한국어 헤더"],
          "schemaVersion": 1
        },
        "rows": [
          ["上海（浦东）", "東京・新宿", "서울，강남"],
          ["Mixed 中文 42", "全角：ＡＢＣ！", "한글/Latin"]
        ],
        "warnings": []
      }
    },
    {
      "id": "csv-no-header-empty-fields",
      "file": "no-header-empty.csv",
      "options": {
        "format": "csv",
        "header": false,
        "mode": "strict"
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 2,
          "columns": ["column_1", "column_2"],
          "schemaVersion": 1
        },
        "rows": [
          ["", "alpha"],
          ["beta", ""]
        ],
        "warnings": []
      }
    },
    {
      "id": "csv-final-record-without-newline",
      "file": "no-final-newline.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "strict"
      },
      "source": {
        "stripFinalNewline": true
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 1,
          "columns": ["name", "value"],
          "schemaVersion": 1
        },
        "rows": [
          ["last", "record"]
        ],
        "warnings": []
      }
    },
    {
      "id": "csv-header-only",
      "file": "header-only.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "strict"
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 0,
          "columns": ["name", "value"],
          "schemaVersion": 1
        },
        "rows": [],
        "warnings": []
      }
    },
    {
      "id": "csv-empty-source",
      "file": "empty.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "strict"
      },
      "source": {
        "stripFinalNewline": true
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 0,
          "columns": [],
