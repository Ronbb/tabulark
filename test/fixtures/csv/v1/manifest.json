        },
        "rows": [],
        "warnings": []
      }
    },
    {
      "id": "csv-ragged-lenient",
      "file": "ragged.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "lenient"
      },
      "expect": {
        "status": "success",
        "metadata": {
          "rows": 2,
          "columns": ["a", "b", "column_3"],
          "schemaVersion": 2
        },
        "rows": [
          ["1", null, null],
          ["2", "", "3"]
        ],
        "warnings": [
          {
            "kind": "ragged-row",
            "row": 0,
            "byteOffset": 4,
            "messageContains": "row has 1 fields"
          },
          {
            "kind": "ragged-row",
            "row": 1,
            "byteOffset": 6,
            "messageContains": "row has 3 fields"
          }
        ]
      }
    },
    {
      "id": "csv-ragged-strict",
      "file": "ragged.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "strict"
      },
      "expect": {
        "status": "error",
        "code": "PARSE_FAILED",
        "kind": "ragged-row",
        "row": 0,
        "byteOffset": 4,
        "messageContains": "row has 1 fields"
      }
    },
    {
      "id": "csv-malformed-quote-strict",
      "file": "malformed-quote.csv",
      "options": {
        "format": "csv",
        "header": true,
        "mode": "strict"
      },
      "expect": {
        "status": "error",
        "code": "PARSE_FAILED",
        "kind": "malformed-quote",
        "byteOffset": 8,
        "messageContains": "quote appears inside an unquoted field"
      }
    },
    {
      "id": "rust-csv-strange-strict",
      "file": "rust-csv-strange.csv",
      "options": {
        "format": "csv",
        "header": false,
        "mode": "strict"
      },
      "expect": {
        "status": "error",
        "code": "PARSE_FAILED",
        "kind": "malformed-quote",
        "byteOffset": 3,
        "messageContains": "unexpected data follows a closing quote"
      }
    },
    {
      "id": "rust-csv-uspop-null-strict",
      "file": "rust-csv-uspop-null.csv",
      "options": {
